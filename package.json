{
  "name": "how-i-bortey",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "test": "vitest run",
    "test:web": "npm --prefix web run test",
    "build:web": "npm --prefix web run build",
    "test:watch": "vitest",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply how-i-bortey-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply how-i-bortey-db --remote"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/webp": "^1.5.0",
    "hono": "^4.6.9",
    "postal-mime": "^4.0.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
